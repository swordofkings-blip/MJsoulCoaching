# ========================================
# 雀魂コーチングくん (.gitignore)
# 配布に不要な一時ファイル・データ・キャッシュを除外
# ========================================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# ----- 仮想環境 -----
venv/
env/
ENV/
.venv/

# ----- IDE -----
.vscode/
.idea/
*.swp
*.swo
*~

# ----- ログ・データファイル -----
# MJAI 対戦ログ
logs/
*.mjson
*.log
data/
share/

# PKL データファイル (人間ログ解析結果、キャッシュ等)
*.pkl
*.pickle

# ----- 一時ファイル -----
temp/
tmp/
*.tmp

# ----- ビルド成果物 (build/ は保持、PyInstaller 中間ファイルは除外) -----
# forwarder.exe は build/ 内に保持
# PyInstaller の中間ファイル (.toc, .pkg, .pyz 等) は除外
build/forwarder/*.toc
build/forwarder/*.pkg
build/forwarder/*.pyz
build/forwarder/localpycs/
build/forwarder/warn-*.txt
build/forwarder/Analysis-*.toc
build/forwarder/EXE-*.toc
build/forwarder/PKG-*.toc
build/forwarder/PYZ-*.toc
# その他のビルド成果物は除外
*.pyc
*.o
*.obj

# ----- PyInstaller onedir ビルド成果物 -----
# dist/以下の _internal/ ディレクトリ (Python ランタイム + ライブラリ)
# 各 DLL, PYD, base_library.zip 等は再生成可能なので除外
dist/**/_internal/
dist/**/_internal/**
dist/**/*.pyd
dist/**/*.dll
dist/**/base_library.zip
dist/**/logs/

# ----- OS 固有 -----
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ----- 配布物 -----
*.zip
*.tar.gz
*.rar
*.7z

# ----- 大容量データ -----
# diffusion-ai 用データ (研究用なので別リポで管理)
diffusion-ai/data/

# ----- 機密情報 -----
.env
*.key
*.pem
secrets.json

# ----- テスト結果 -----
.pytest_cache/
.coverage
htmlcov/
.tox/

# ----- 遺伝的アルゴリズム作業ファイル -----
ga_work/
gene_variants/*_backup.json
